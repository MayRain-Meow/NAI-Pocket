    "android:release": "node scripts/android.mjs release",
    "test:offline": "node tests/offline-integration.mjs",
    "test:queue": "node --check src/queue-runner.js && node --check src/queue.js && node --check src/api.js && node tests/queue-runner.test.mjs && node tests/phone-gallery.test.mjs && node tests/updater.test.mjs",
    "test:artist-resources": "node scripts/test-artist-resources.mjs",
    "preview:offline": "npm run build && node tests/offline-integration.mjs --preview"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "buffer": "6.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "parse5": "8.0.1",
    "postcss": "8.5.29"
  },
  "overrides": {
    "xcode": { "uuid": "11.1.1" }
  }
